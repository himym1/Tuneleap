{
  "version": "2.4",
  "variables": {
    "color-bg": {
      "type": "color",
      "value": "#F7F7F4"
    },
    "color-surface": {
      "type": "color",
      "value": "#FFFFFF"
    },
    "color-surface-soft": {
      "type": "color",
      "value": "#F5F4F1"
    },
    "color-text": {
      "type": "color",
      "value": "#1A1918"
    },
    "color-text-muted": {
      "type": "color",
      "value": "#6D6C6A"
    },
    "color-text-faint": {
      "type": "color",
      "value": "#9C9B99"
    },
    "color-primary": {
      "type": "color",
      "value": "#3D8A5A"
