# navidrome-backend 环境变量配置

# API 鉴权密钥（必填，客户端使用 Navidrome 密码作为此 Key）
API_KEY=your-secret-key-here

# 上游音乐 API 地址（一般不需要修改）
MUSIC_API_BASE_URL=https://music-api.gdstudio.xyz/api.php

# Navidrome SQLite 数据库路径（容器内路径）
NAVIDROME_DB_PATH=/data/navidrome.db

# 音乐文件根目录（容器内路径）
MUSIC_DIR=/music

# 下载的在线音乐保存目录
DOWNLOAD_DIR=/music/download

# HTTP 请求超时（秒）
HTTP_TIMEOUT=30
