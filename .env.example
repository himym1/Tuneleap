# Public control plane — never put NAS disk paths here.

# Shared API key for early development (Flutter X-API-Key).
# Replace with register/login sessions in a later phase.
API_KEY=change-me-cloud

# Comma-separated gdstudio/Solara-shaped bases (first-success / failover).
GDSTUDIO_API_BASE_URLS=https://music-api.gdstudio.xyz/api.php

# Optional Meting-shaped bases (OpenMusic-compatible upstream style).
# Leave empty until you configure a real Meting endpoint.
METING_API_BASE_URLS=

# HTTP client
HTTP_TIMEOUT_SECONDS=30

# Upstream pool
UPSTREAM_COOLDOWN_SECONDS=60
UPSTREAM_STRATEGY=ordered  # ordered | race

# Private updates (local dir served by this process in scaffold)
RELEASE_DIR=./releases

# App
APP_NAME=navidrome-cloud
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8600

# Postgres — wire when implementing auth/recommendations
# DATABASE_URL=postgresql+asyncpg://user:pass@127.0.0.1:5432/navidrome_cloud

# Auth (SQLite file store by default; JWT HS256)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
AUTH_DB_PATH=./data/auth.db

# Recommendations (SQLite; no Navidrome library mount on cloud)
RECOMMENDATION_DB_PATH=./data/recommendations.db
RECOMMENDATION_SESSION_TTL_HOURS=24
RECOMMENDATION_POOL_TARGET=60
RECOMMENDATION_POOL_LOW_WATERMARK=20
RECOMMENDATION_PAGE_MAX=20
RECOMMENDATION_UPSTREAM_CONCURRENCY=5
RECOMMENDATION_DISCOVERY_SEEDS=流行新歌,热门歌曲,经典歌曲
RECOMMENDATION_SOURCES=netease,migu,joox

# Optional later
# DATABASE_URL=postgresql+asyncpg://navidrome:change-me@127.0.0.1:5432/navidrome_cloud

# Optional: pull library weak-identities from nas-agent for recommendation blocking.
# Cloud still never mounts navidrome.db; nas-agent remains the only process with DB access.
NAS_AGENT_URL=
NAS_AGENT_KEY=
