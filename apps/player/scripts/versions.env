# Per-platform versions. Bump only the platform you are shipping.
# Android reads version.json.android; macOS also reads appcast.xml;
# Windows reads version.json.windows. Do not lock-step all three.
# flutter build uses --build-name=VERSION --build-number=BUILD

ANDROID_VERSION=1.0.64
ANDROID_BUILD=61

IOS_VERSION=1.0.1
IOS_BUILD=1

MACOS_VERSION=1.0.64
MACOS_BUILD=61

WINDOWS_VERSION=1.0.67
WINDOWS_BUILD=64
