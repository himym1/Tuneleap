# Public control plane — never put NAS disk paths here.

# Shared API key for early development (Flutter X-API-Key).
API_KEY=change-me-cloud

# Comma-separated gdstudio/Solara-shaped bases.
GDSTUDIO_API_BASE_URLS=https://music-api.gdstudio.xyz/api.php
METING_API_BASE_URLS=
METING_API_TOKEN=
CHKSZ_API_BASE_URL=https://api.chksz.com
CHKSZ_API_KEY=
HTTP_TIMEOUT_SECONDS=30
UPSTREAM_COOLDOWN_SECONDS=60
UPSTREAM_STRATEGY=ordered
MUSIC_ADAPTER_ORDER=meting,gdstudio,chksz
MUSIC_SEARCH_SOURCES=netease,migu,joox

# Postgres — required cloud source of truth.
POSTGRES_DB=navidrome_cloud
POSTGRES_USER=navidrome
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://navidrome:change-me-postgres@postgres:5432/navidrome_cloud
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10

# JWT product auth.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_MINUTES=1440
JWT_REFRESH_TTL_DAYS=90

# Recommendations.
RECOMMENDATION_SESSION_TTL_HOURS=24
RECOMMENDATION_POOL_TARGET=60
RECOMMENDATION_POOL_LOW_WATERMARK=20
RECOMMENDATION_PAGE_MAX=20
RECOMMENDATION_UPSTREAM_CONCURRENCY=5
RECOMMENDATION_DISCOVERY_SEEDS=流行新歌,热门歌曲,经典歌曲
RECOMMENDATION_SOURCES=netease,migu,joox

# Optional NAS agent library blocking.
NAS_AGENT_URL=
NAS_AGENT_KEY=

# Private updates.
RELEASE_DIR=./releases

# Legacy SQLite files are read only by scripts/migrate_sqlite_to_postgres.py.
AUTH_DB_PATH=./data/auth.db
RECOMMENDATION_DB_PATH=./data/recommendations.db

APP_NAME=navidrome-cloud
APP_VERSION=0.2.0
HOST=0.0.0.0
PORT=8600
